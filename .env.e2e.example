# Playwright가 사용할 dev 어드민 계정입니다.
E2E_ADMIN_LOGIN_ID=
E2E_ADMIN_PASSWORD=

# 목록에 유지할 전용 QA 레코드의 postId입니다.
# 문의 ID는 첨부·공개 최상위 댓글이 있고 상태 변경과 댓글 CRUD가 가능해야 합니다.
# 댓글 첫 페이지에는 새 E2E 댓글이 노출될 수 있는 여유가 있어야 합니다.
E2E_QA_INQUIRY_ID=
# 신고 ID는 상세와 신고글 원문 링크가 정상인 데이터여야 합니다.
E2E_QA_REPORT_ID=

# 실제 단일건 포인트 지급/차감 테스트에 사용할 별도 dev 테스트 회원 아이디입니다.
# 로그인 계정과 구분하며, 테스트 회원의 비밀번호는 필요하지 않습니다.
E2E_QA_POINT_LOGIN_ID=
